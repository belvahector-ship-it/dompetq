<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notifikasi pengingat. Sejak Android 13 harus diminta saat berjalan,
         tidak cukup dideklarasikan di sini. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Alarm tepat waktu: gaji tanggal 5 harus ditanya tanggal 5, bukan
         "kira-kira minggu ini" saat sistem sedang senggang.

         Sengaja HANYA SCHEDULE_EXACT_ALARM, yang diberikan pengguna lewat
         pengaturan. Saudaranya USE_EXACT_ALARM memang tidak perlu diminta,
         tapi Google Play membatasinya untuk aplikasi yang fungsi UTAMANYA
         alarm/kalender — aplikasi keuangan yang memakainya berisiko
         ditolak. Kalau izin ini tidak diberikan, alarm tetap dipasang
         secara longgar (lihat AlarmPenjadwal).

         Lint menandainya ProtectedPermissions karena protection level-nya
         signature|privileged|appop. Bagian "appop" itulah yang membuatnya
         tetap bisa dipakai aplikasi biasa: pengguna memberikannya lewat
         Pengaturan → Alarm & pengingat, dan hasilnya dibaca
         canScheduleExactAlarms(). Menghapusnya berarti alarm tidak pernah
         bisa tepat waktu, jadi peringatannya dibungkam di sini saja. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:ignore="ProtectedPermissions" />

    <!-- Alarm hilang saat perangkat dimatikan; dijadwalkan ulang saat boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Kalender: jatuh tempo pengingat ditulis sebagai agenda berulang. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:name=".DompetQApp"
        android:supportsRtl="true"
        android:theme="@style/Theme.DompetQ">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.DompetQ">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ekspor CSV/JSON ditulis ke cache lalu dibagikan lewat lembar
             berbagi sistem. Berkas di cache tidak bisa diserahkan ke
             aplikasi lain sebagai file:// sejak Android 7. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Dipicu AlarmManager saat pengingat jatuh tempo. -->
        <receiver
            android:name=".pengingat.AlarmPengingatReceiver"
            android:exported="false" />

        <!-- Menjadwalkan ulang semua alarm setelah perangkat menyala. -->
        <receiver
            android:name=".pengingat.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
